# ==============================================================================
# ORCA Backend — Production & Development Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit real API keys, passwords, or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
ORCA_ENVIRONMENT=development
ORCA_APP_NAME="ORCA API"
ORCA_API_PREFIX=""
ORCA_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# Database Configuration (leave empty to use default SQLite orca.db)
# Production: postgresql://orca_user:secure_password@db_host:5432/orca
ORCA_DATABASE_URL=

# Authentication & Security
# Generate a strong 32+ character secret for production JWT signing
ORCA_JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
ORCA_ADMIN_EMAIL=admin@orca.gov
ORCA_ADMIN_PASSWORD=AdminPassword123!

# Map / Spatial Services (optional external tile or geocoding keys)
ORCA_MAP_API_KEY=

# ------------------------------------------------------------------------------
# LLM Integration (Groq / OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
# Set GROQ_API_KEY or ORCA_LLM_API_KEY with your API key
GROQ_API_KEY=
ORCA_LLM_API_KEY=
ORCA_LLM_BASE_URL=https://api.groq.com/openai/v1
ORCA_LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# RAG (Retrieval-Augmented Generation) Settings
# ------------------------------------------------------------------------------
# Master switch: Set to "true" to activate knowledge retrieval in the LangGraph workflow.
# Default: false (zero cold-start penalty, live-agent pipeline only)
RAG_ENABLED=false

# Vector Database backend (currently "chroma" is supported)
RAG_VECTOR_DB=chroma

# Name of the ChromaDB persistent collection containing indexed ORCA knowledge
RAG_COLLECTION=orca_knowledge

# Sentence-Transformers embedding model.
# Must match the model used to build the ChromaDB index (Phase 2).
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Maximum number of chunks to retrieve per grounded query (1 to 20)
RAG_TOP_K=5

# Minimum cosine relevance score threshold (0.0 to 1.0).
# Chunks below this threshold are dropped to avoid hallucinations.
RAG_MIN_RELEVANCE_SCORE=0.35

# Optional override for knowledge documents path (defaults to <repo_root>/orca-knowledge)
# RAG_KNOWLEDGE_PATH=

# Optional override for ChromaDB persistent storage directory
# (defaults to backend/data/rag/chroma)
# RAG_PERSIST_DIRECTORY=

# Pre-warm embedding model and ChromaDB client during application startup.
# Recommended for production containers (e.g. Render) to avoid first-query latency.
# Default: false
RAG_WARMUP_ON_STARTUP=false
